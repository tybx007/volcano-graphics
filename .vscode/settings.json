{
    "files.encoding": "utf8",
    "files.eol": "\r\n",
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.rulers": [88],
    "files.associations": {
        "*.h": "cpp"
    },
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "workbench.startupEditor": "readme"
}
